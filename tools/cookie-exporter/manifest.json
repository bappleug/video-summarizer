{
  "manifest_version": 3,
  "name": "Cookie 导出助手",
  "version": "1.2.0",
  "description": "检测小红书/B站登录态，一键把 Cookie 直写 keys.env。无网络权限，Cookie 不出本机。",
  "action": {
    "default_title": "Cookie 导出助手",
    "default_popup": "popup.html"
  },
  "key": "",
  "permissions": [
    "cookies",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "*://*.xiaohongshu.com/*",
    "*://*.bilibili.com/*"
  ]
}
